# Copy to .env.local and fill in. Restart Metro (npx expo start -c) after changes.

# Supabase project (Settings -> API). The publishable key is safe to ship in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# "supabase" for live shared data, "mock" for the offline in-memory demo.
EXPO_PUBLIC_DATA_SOURCE=supabase
